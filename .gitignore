# The original game is not part of this repository: install it in ~/Civ2
# (or set CIV2_GAME).
/orig/
/*.zip

# Build outputs, runs, packages; the HD graphics' art, made by make hd-art
# (tools/build_hd_pack.py: Peter Johnson's openciv2-assets, not part of this
# repository)
/data/native/hd/
/build/
/run/
/dist/
hook/*.o
hook/XDaemon.dll
__pycache__/
*.pyc

# OpenCiv2's own sound effects (src/platform/sound.c: sound_fallback): still
# being chosen, kept out of the repository until they are; the game, the
# packages and make test-sound do without them
/data/native/sound/

# OpenCiv2's own music and heralds (src/platform/sound.c: cd_open_track;
# hd.c: hd_herald_find), made by make own-assets (tools/build_own_assets.py:
# OpenCiv2's openciv2/openciv2-assets at the commit pinned in
# data/own-assets.json)
/data/native/music/
/data/native/heralds/

# Ghidra project and logs (re/ keeps the exported tables and decomp.c)
/re/gproj/
/re/*.tgz
/re/*.log

# Downloaded toolchain (tools/fetch-toolchain.sh)
/tools/toolchain
/tools/docker-ext/*.tar.gz
# OpenCiv2's own HD pictures and heralds (src/platform/hd.c: load_pictures,
# hd_herald_find): a local staging folder for art being tried before it goes
# to the art pack (docs/HD-GRAPHICS.md); the game, the packages, make web and
# the tests do without it; the review site's deploy takes it when present
/data/native/hd-extra/
