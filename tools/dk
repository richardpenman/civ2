#!/bin/sh
# Run a command inside the civ2-dev container: the project at /work, the
# installed game ($CIV2_GAME, default ~/Civ2) at /civ2; EXE, TIMEOUT, SEED,
# JOBS and the CIV2_* debugging variables are passed through.
cd "$(dirname "$0")/.." || exit 1
exec docker run --rm -i -v civ2-wine:/wine -v "$PWD":/work -v "${CIV2_GAME:-$HOME/Civ2}":/civ2:ro -e CIV2_GAME=/civ2 \
    -e EXE -e TIMEOUT -e SEED -e JOBS -e CIV2_NORMAL_DESKTOP -e CIV2_TRACE_MSG -e CIV2_APITRACE -e CIV2_CLOCKLOG -e CIV2_TICKCALLERS -e CIV2_LOG_TEXT -e CIV2_RAND_BT -e CIV2_STACKPROBE -e CIV2_REAL_FILEDLG -e CIV2_STRICT -e CIV2_TEST_AUDIO -e SDL_AUDIODRIVER -e CIV2_LOG_VIDEO -e CIV2_REALTIME -e CIV2_TEST_NATIVE -e CIV2_TEST_FIXES -e CIV2_TEST_EXTRAS -e CIV2_TEST_SETTINGS -e CIV2_TEST_SUPPRESS -e CIV2_TEST_FULL -e CIV2_CLASSIC \
    -w /work civ2-dev "$@"
